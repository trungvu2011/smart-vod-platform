# Public hosts (point these DNS records to your VM public IP)
APP_HOST=trungvuduc.id.vn
API_HOST=api.trungvuduc.id.vn
MEDIA_HOST=media.trungvuduc.id.vn
LIVEKIT_HOST=livekit.trungvuduc.id.vn
ACME_EMAIL=you@example.com

# PostgreSQL
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=vod_db

# App secrets
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET_NAME=videos

# LiveKit API credentials (must match livekit.prod.yaml / egress.prod.yaml unless you edit those files)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=supersecretlivekitkeythatisverylong32chars

# AI/Search
GROQ_API_KEY=change_me_groq_key
GEMINI_API_KEY=
PEXELS_API_KEY=
YOUTUBE_API_KEY=
WHISPER_MODEL=small
WHISPER_LANGUAGE=vi
AI_WHISPER_ENABLED=true
AI_REQUIRED=false
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_INDEX_VIDEOS=videos

# GHCR image names
GHCR_OWNER=your-github-username-or-org
FRONTEND_IMAGE=smartvod-frontend
API_IMAGE=smartvod-api
WORKER_IMAGE=smartvod-worker
IMAGE_TAG=latest
