// =========================================
// CẤU HÌNH DATABASE
// =========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// ENUMS
// =========================================
enum Role {
  USER
  ADMIN
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  BANNED
}

// =========================================
// MODELS
// =========================================

model User {
  id            String         @id @default(uuid()) @map("user_id")
  fullName      String         @db.VarChar(100) @map("full_name")
  email         String         @unique @db.VarChar(150)
  passwordHash  String         @db.VarChar(255) @map("password_hash")
  role          Role           @default(USER)
  avatarUrl     String?        @map("avatar_url")
  createdAt     DateTime       @default(now()) @map("created_at")

  // --- Quan hệ ---
  videos        Video[]        // Video đã đăng
  comments      Comment[]      // Bình luận đã viết
  likes         Like[]         // Các lượt Like
  playlists     Playlist[]     // Danh sách phát tự tạo
  watchHistory  WatchHistory[] // Lịch sử xem

  @@map("users")
}

model Video {
  id              String      @id @default(uuid()) @map("video_id")
  creatorId       String      @map("creator_id")
  title           String      @db.VarChar(255)
  description     String?     @db.Text
  thumbnailUrl    String?     @map("thumbnail_url")
  status          VideoStatus @default(PENDING)
  viewCount       Int         @default(0) @map("view_count")
  createdAt       DateTime    @default(now()) @map("created_at")

  // --- Quan hệ ---
  creator         User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  metadata        VideoMetadata?
  comments        Comment[]
  likes           Like[]
  playlistItems   PlaylistItem[]
  watchHistory    WatchHistory[]

  @@map("videos")
}

model VideoMetadata {
  id                 String  @id @default(uuid()) @map("metadata_id")
  videoId            String  @unique @map("video_id")
  hlsMasterUrl       String? @map("hls_master_url")
  subtitleUrl        String? @map("subtitle_url")
  aiSummary          String? @db.Text @map("ai_summary")
  duration           Int     @default(0) // Độ dài video (giây)
  video              Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_metadata")
}

model Comment {
  id        String   @id @default(uuid()) @map("comment_id")
  content   String   @db.Text
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id") // Để làm comment lồng nhau (reply)
  createdAt DateTime @default(now()) @map("created_at")

  // --- Quan hệ ---
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@map("comments")
}

model Like {
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")

  // --- Quan hệ ---
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId]) // Khóa chính tổ hợp: Một người chỉ like 1 video 1 lần
  @@map("likes")
}

model Playlist {
  id          String   @id @default(uuid()) @map("playlist_id")
  userId      String   @map("user_id")
  name        String   @db.VarChar(255)
  isPrivate   Boolean  @default(false) @map("is_private")
  createdAt   DateTime @default(now()) @map("created_at")

  // --- Quan hệ ---
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@map("playlists")
}

model PlaylistItem {
  playlistId String   @map("playlist_id")
  videoId    String   @map("video_id")
  order      Int      // Thứ tự video trong playlist
  addedAt    DateTime @default(now()) @map("added_at")

  // --- Quan hệ ---
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([playlistId, videoId])
  @@map("playlist_items")
}

model WatchHistory {
  id         String   @id @default(uuid()) @map("history_id")
  userId     String   @map("user_id")
  videoId    String   @map("video_id")
  watchedAt  DateTime @default(now()) @map("watched_at")
  lastSecond Int      @default(0) @map("last_second") // Lưu lại xem đến giây thứ mấy để "Xem tiếp"

  // --- Quan hệ ---
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("watch_history")
}